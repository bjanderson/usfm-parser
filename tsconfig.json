{
  "compilerOptions": {
    "baseUrl": "./",
    "declaration": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["esnext"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./bin",
    "rootDir": "./src",
    "target": "esnext"
  },
  "exclude": [
    "coverage",
    "bin",
    "doc",
    "jest",
    "node_modules",
    "scripts",
    "**/*.spec.ts",
    "**/*.mock.ts"
  ]
}
